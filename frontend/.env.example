# Frontend
# Use the deployed backend URL in production. Do not leave a trailing slash.
VITE_API_BASE_URL=https://levelupp-2b3j.onrender.com
VITE_AI_API_URL=

# Backend
BACKEND_PUBLIC_URL=https://levelupp-2b3j.onrender.com
FRONTEND_URL=https://levellupp.netlify.app
DATABASE_PATH=./backend/levelup.sqlite

# Payment provider (aggregator / official gateway)
PAYMENT_PROVIDER=generic
PAYMENT_API_BASE_URL=
PAYMENT_CREATE_ORDER_PATH=/v1/orders
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Map local payment methods to provider-specific method codes
PAYMENT_METHOD_MBANK_CODE=mbank
PAYMENT_METHOD_ELSOM_CODE=elsom
PAYMENT_METHOD_ODENGI_CODE=odengi

# Only for local debugging without signatures. Keep false in production.
PAYMENT_SKIP_WEBHOOK_SIGNATURE=false
