# Backend
PORT=8787
BACKEND_PORT=8787
BACKEND_PUBLIC_URL=https://levelupp-2b3j.onrender.com
FRONTEND_URL=https://levelupp-cyan.vercel.app
# Optional: extra site origins allowed by CORS, comma separated (Vercel previews levelupp-*.vercel.app are allowed automatically)
CORS_ALLOWED_ORIGINS=
# PostgreSQL connection string. When set, all tables are created in PostgreSQL and every write is
# mirrored there (SQLite at DATABASE_PATH is only the working copy, reloaded from PostgreSQL at startup).
# Run only ONE backend instance per DATABASE_URL. Leave blank to use SQLite only.
DATABASE_URL=
DATABASE_PATH=./levelup.sqlite

# ─── Admin account ─────────────────────────────────────────────────────────────
# The email address of the single administrator account.
ADMIN_EMAIL=admin@levelup.kg
# Set this ONLY for first-time setup. The server creates the admin and logs a
# reminder. Remove this variable immediately after the first successful login.
# Change the password afterwards in Admin Panel → Settings.
# An already existing admin account is not affected.
ADMIN_INITIAL_PASSWORD=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required for Forgot Password emails and password-change confirmations.
# Leave blank to disable email sending (reset URL is logged to the server console).
# Port 587 = STARTTLS, 465 = SSL. For Gmail use an "App password", not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=LEVEL UP <noreply@levelup.kg>
# Alternative to SMTP: Brevo HTTPS API (needed on Render FREE instances, which block outbound SMTP ports).
# When set, e-mails go through Brevo instead of SMTP; EMAIL_FROM must be a verified sender in Brevo.
BREVO_API_KEY=

# Optional: password-reset requests allowed per IP per hour (default 10)
PASSWORD_RESET_RATE_LIMIT_MAX=

# Admin "Forgot password?" sends a 6-digit code to ADMIN_EMAIL through the SMTP settings above
# (code valid 5 minutes, resend after 60 s, 5 wrong attempts per code).
# Optional per-IP limits: code requests per hour (default 10), code/password checks per 15 min (default 30)
ADMIN_RESET_REQUEST_LIMIT_MAX=
ADMIN_RESET_VERIFY_LIMIT_MAX=
# Optional: login attempts per IP per 15 minutes (default 15)
LOGIN_RATE_LIMIT_MAX=

# Telegram admin notifications (registrations + verified purchases). Leave blank to disable.
# Token from @BotFather; chat ID of the admin chat (see README). TELEGRAM_CHAT_ID is accepted as a fallback.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# AI PRO assistant. Google Gemini key (https://aistudio.google.com/apikey); preferred when set.
# Without GEMINI_API_KEY and ANTHROPIC_API_KEY the AI chat answers 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash (falls back to other Flash models when it is overloaded)
GEMINI_MODEL=
# Optional: AI questions per IP per minute (default 20)
AI_CHAT_RATE_LIMIT_MAX=
# Alternative provider: Claude API, used only when GEMINI_API_KEY is empty.
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5
AI_MODEL=

# Manual bank transfer (purchase request approved by the administrator). Shown to buyers only when
# MANUAL_TRANSFER_ENABLED=true and MANUAL_TRANSFER_ACCOUNT is set. These are public payment details, not secrets.
MANUAL_TRANSFER_ENABLED=false
MANUAL_TRANSFER_BANK_NAME=
MANUAL_TRANSFER_RECIPIENT=
MANUAL_TRANSFER_ACCOUNT=
MANUAL_TRANSFER_INSTRUCTIONS=

# Card checkout mode. Anything other than "live" = DEMO: the card form activates the plan immediately
# with NO real charge (only the last 4 card digits reach the server). Set PAYMENT_MODE=live once a real
# provider below is configured; then the demo form is disabled.
PAYMENT_MODE=demo

# Payment provider (aggregator / official gateway)
PAYMENT_PROVIDER=generic
PAYMENT_API_BASE_URL=
PAYMENT_CREATE_ORDER_PATH=/v1/orders
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Map local payment methods to provider-specific method codes
PAYMENT_METHOD_MBANK_CODE=mbank
PAYMENT_METHOD_ELSOM_CODE=elsom
PAYMENT_METHOD_ODENGI_CODE=odengi

# Only for local debugging without signatures. Keep false in production.
PAYMENT_SKIP_WEBHOOK_SIGNATURE=false

# Number of reverse proxies in front of the app (Render = 1). Needed for correct per-IP rate limiting.
TRUST_PROXY_HOPS=1

# Local development only: create the demo account aisha@levelup.kg (known password). Never enable in production.
SEED_DEMO_USER=false
