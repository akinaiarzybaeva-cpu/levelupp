# Backend
PORT=8787
BACKEND_PORT=8787
BACKEND_PUBLIC_URL=https://levelupp-2b3j.onrender.com
FRONTEND_URL=https://levelupp-cyan.vercel.app
# NOTE: the backend currently uses SQLite only (DATABASE_PATH). DATABASE_URL is not read by the code.
DATABASE_URL=
DATABASE_PATH=./levelup.sqlite

# ─── Admin account ─────────────────────────────────────────────────────────────
# The email address of the single administrator account.
ADMIN_EMAIL=admin@levelup.kg
# Set this ONLY for first-time setup. The server creates the admin and logs a
# reminder. Remove this variable immediately after the first successful login.
ADMIN_INITIAL_PASSWORD=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Required for Forgot Password emails and password-change confirmations.
# Leave blank to disable email sending (reset URL is logged to the server console).
# Port 587 = STARTTLS, 465 = SSL. For Gmail use an "App password", not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=LEVEL UP <noreply@levelup.kg>

# Optional: password-reset requests allowed per IP per hour (default 10)
PASSWORD_RESET_RATE_LIMIT_MAX=

# Telegram notifications for new user registrations (optional; leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payment provider (aggregator / official gateway)
PAYMENT_PROVIDER=generic
PAYMENT_API_BASE_URL=
PAYMENT_CREATE_ORDER_PATH=/v1/orders
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Map local payment methods to provider-specific method codes
PAYMENT_METHOD_MBANK_CODE=mbank
PAYMENT_METHOD_ELSOM_CODE=elsom
PAYMENT_METHOD_ODENGI_CODE=odengi

# Only for local debugging without signatures. Keep false in production.
PAYMENT_SKIP_WEBHOOK_SIGNATURE=false

# Number of reverse proxies in front of the app (Render = 1). Needed for correct per-IP rate limiting.
TRUST_PROXY_HOPS=1

# Local development only: create the demo account aisha@levelup.kg (known password). Never enable in production.
SEED_DEMO_USER=false
